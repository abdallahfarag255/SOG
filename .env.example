# انسخ هذا الملف باسم .env واملأ القيم بتاعتك (.env متسجلش في git)

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=ضع_معرف_الشيت_هنا
# مدة تخزين نتيجة قراءة الشيت مؤقتًا (بالثواني) قبل إعادة القراءة
SHEETS_CACHE_TTL_SECONDS=60

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=ضع_service_role_key_هنا

# --- Tesseract (لو مش في PATH، حط المسار الكامل لـ tesseract.exe) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ملاحظة: بيانات تسجيل الدخول (username/password) متخزنة في جدول users في Supabase،
# مش في ملف الإنف. راجع supabase_schema.sql وقسم "إضافة مستخدم" في README.
